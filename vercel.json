{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "[ -d ../cc-webgl ] || git clone --depth 1 https://github.com/Classiccottrell/cc-webgl ../cc-webgl; npm --prefix ../cc-webgl ci && npm --prefix ../cc-webgl run build && npm ci && npm --prefix app ci",
  "buildCommand": "npm run build && npm --prefix app run build",
  "outputDirectory": "app/dist",
  "rewrites": [
    {
      "source": "/editor",
      "destination": "/index.html"
    },
    {
      "source": "/editor/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/embed/forma.v(.*).js",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(textures|environments)/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
